#!/bin/bash

## Description: Run all quality checks: mago, lint, and tests
## Usage: check
## Example: "ddev check"

set -e

echo "==> Running mago lint..."
mago lint

echo "==> Checking mago formatting..."
mago format --check

echo "==> Running code style checks (Pint)..."
vendor/bin/pint --test

echo "==> Running static analysis (PHPStan)..."
vendor/bin/phpstan --memory-limit=1G analyse

echo "==> Resetting testing database..."
meta/bin/reset-testing-database

echo "==> Running tests..."
vendor/bin/pest
